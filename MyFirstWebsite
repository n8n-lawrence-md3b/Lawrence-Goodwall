<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random plus Tech Facts</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            width: 100%;
            padding: 50px 40px;
            text-align: center;
        }

        h1 {
            color: #1e3c72;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            color: #666;
            margin-bottom: 40px;
            font-size: 0.95em;
        }

        .fact-box {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2em;
            line-height: 1.6;
            transition: all 0.3s ease;
        }

        .fact-box:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 30px rgba(30, 60, 114, 0.4);
        }

        .fact-number {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8em;
            margin-bottom: 15px;
        }

        button {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 1.1em;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 10px 5px;
            font-weight: 600;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(30, 60, 114, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        .button-group {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .fact-count {
            color: #999;
            font-size: 0.9em;
            margin-top: 20px;
        }

        .category-badge {
            display: inline-block;
            background: #2a5298;
            color: white;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 0.85em;
            margin-top: 15px;
        }

        @media (max-width: 480px) {
            .container {
                padding: 30px 20px;
            }

            h1 {
                font-size: 2em;
            }

            .fact-box {
                font-size: 1.1em;
                padding: 20px;
                min-height: 100px;
            }

            button {
                padding: 12px 30px;
                font-size: 1em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>💻 Tech Facts</h1>
        <p class="subtitle">Click the button to discover amazing technology facts!</p>
        
        <div class="fact-box" id="factBox">
            <span id="factText">Click "New Fact" to get started!</span>
        </div>

        <div class="button-group">
            <button onclick="displayRandomFact()">✨ New Fact</button>
            <button onclick="resetFacts()">🔄 Reset Counter</button>
        </div>

        <div class="fact-count">
            Facts Discovered: <span id="factIndex">0</span> of <span id="totalFacts">0</span>
        </div>
    </div>

    <script>
        const techFacts = [
            "The first iPhone was released on June 29, 2007.",
            "More data is generated in a single day now than was created in the entire year of 1995.",
            "The '@' symbol is called 'at sign' in English but has different names worldwide.",
            "The term 'computer bug' comes from an actual moth found in a computer by Grace Hopper in 1947.",
            "Wi-Fi doesn't stand for 'Wireless Fidelity' – it's actually just a made-up term!",
            "There are more than 1.5 billion active websites on the internet.",
            "The first email was sent in 1971.",
            "Google processes over 99,000 searches every second.",
            "The average person spends about 6 months of their lifetime waiting for red lights to turn green.",
            "The first webcam was invented to monitor a coffee pot at Cambridge University.",
            "A single cloud can weigh as much as 100 elephants, and the internet uses a lot of cloud storage.",
            "It takes 12 hours to fully charge a smartphone battery, but only 5 minutes of wireless charging.",
            "The world's first computer programmer was a woman named Ada Lovelace.",
            "Bitcoin was worth just a fraction of a cent when it was first created in 2009.",
            "The first digital camera was invented in 1975 by Steven Sasson at Kodak.",
            "YouTube gets more than 500 hours of video uploaded every single minute.",
            "The Internet weighs as much as an average strawberry due to electron movement.",
            "There are approximately 1.4 billion active users on Facebook worldwide.",
            "The QWERTY keyboard layout was designed to prevent mechanical typewriter jams.",
            "Hewlett-Packard was founded in a garage in 1939, starting with oscillators.",
            "The first Apple computer was sold for $666.66 in 1976.",
            "It would take about 4 million years for a modern computer to decrypt a 256-bit encryption.",
            "The first text message was sent on December 3, 1992.",
            "Amazon started as an online bookstore from a garage in 1994.",
            "Netflix was founded in 1997 as a DVD rental service by mail.",
            "LinkedIn has over 900 million members worldwide.",
            "The average person touches their phone 2,617 times per day.",
            "Artificial intelligence can now diagnose skin cancer better than dermatologists.",
            "The first Instagram post was shared by co-founder Kevin Systrom in 2010.",
            "Twitter was originally going to be called 'twttr' after the Flickr naming pattern.",
            "The most expensive domain name ever sold was 'cars.com' for $872.7 million.",
            "The first online purchase was a Sting CD, bought on August 11, 1994.",
            "Zoom was founded in 2011 and only became mainstream during the 2020 pandemic.",
            "The first smartwatch was released by Microsoft in 2003.",
            "Virtual Reality technology dates back to the 1960s.",
            "The first video game ever played over the internet was called Spacewar! in 1977.",
            "Minecraft has sold over 300 million copies, making it the best-selling game ever.",
            "The PlayStation 2 is the best-selling gaming console of all time with 155 million units sold.",
            "Discord was founded in 2015 and now has over 150 million monthly active users.",
            "Snapchat was founded in 2011 and is now worth billions of dollars.",
            "The first 1GB hard drive cost $3,500 in 1997.",
            "A single byte of data uses about as much energy as moving a grain of sand 1 inch.",
            "The first selfie was taken by Robert Cornelius in 1839 using a polished silver plate.",
            "Reddit was founded in 2005 and now has over 430 million monthly active users.",
            "The Dark Web makes up about 96% of the internet by content volume.",
            "Blockchain technology was first conceptualized in 1991.",
            "The first bot on Twitter was created in 2006.",
            "Metaverse technology is estimated to be worth over $1 trillion by 2030.",
            "The first GitHub repository was created in 2008.",
            "3D printing was invented in 1984 by Chuck Hull."
        ];

        let displayedFacts = new Set();

        function displayRandomFact() {
            if (displayedFacts.size === techFacts.length) {
                alert('You\'ve seen all the tech facts! Resetting...');
                resetFacts();
                return;
            }

            let randomIndex;
            let randomFact;

            do {
                randomIndex = Math.floor(Math.random() * techFacts.length);
                randomFact = techFacts[randomIndex];
            } while (displayedFacts.has(randomFact));

            displayedFacts.add(randomFact);

            const factBox = document.getElementById('factBox');
            factBox.style.opacity = '0';

            setTimeout(() => {
                document.getElementById('factText').textContent = randomFact;
                document.getElementById('factIndex').textContent = displayedFacts.size;
                document.getElementById('totalFacts').textContent = techFacts.length;
                factBox.style.opacity = '1';
            }, 150);
        }

        function resetFacts() {
            displayedFacts.clear();
            document.getElementById('factIndex').textContent = '0';
            document.getElementById('factText').textContent = 'Click "New Fact" to get started!';
        }

        // Add smooth transition
        document.getElementById('factBox').style.transition = 'opacity 0.3s ease';

        // Initialize fact count
        document.getElementById('totalFacts').textContent = techFacts.length;

        // Display initial fact on page load
        window.addEventListener('load', () => {
            displayRandomFact();
        });
    </script>
</body>
</html>
